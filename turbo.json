{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**"],
      "env": ["VITE_OPERATIONS_*", "VITE_CUSTOMER_*", "NODE_ENV"]
    },
    "typecheck": { "outputs": [] },
    "lint": { "outputs": [] },
    "test": { "outputs": [] },
    "@tirodhan/customer-web#test": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/customer-mobile/src/**",
        "$TURBO_ROOT$/apps/customer-mobile/app/**"
      ]
    }
  }
}
