<?xml version="1.0" encoding="utf-8"?>
<!-- CANDIDATE ONLY. Attach only after effective-policy and mobile regression review. Never deployed by this repository. -->
<policies>
  <inbound>
    <choose>
      <when condition="@(context.Request.Headers.ContainsKey(&quot;Origin&quot;) &amp;&amp; new [] { &quot;/v1/auth/otp/start&quot;, &quot;/v1/auth/otp/verify&quot;, &quot;/v1/auth/refresh&quot;, &quot;/v1/auth/logout&quot; }.Contains(context.Request.OriginalUrl.Path))">
        <return-response>
          <set-status code="403" reason="Web session adapter required"/>
          <set-header name="Cache-Control" exists-action="override"><value>private, no-store</value></set-header>
          <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
          <set-body>{"error":"WEB_SESSION_ADAPTER_REQUIRED"}</set-body>
        </return-response>
      </when>
    </choose>
    <base/>
  </inbound>
  <backend><base/></backend>
  <outbound><base/></outbound>
  <on-error><base/></on-error>
</policies>
