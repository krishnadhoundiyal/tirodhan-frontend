{
  "name": "tirodhan-frontend",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:customer-web": "pnpm --filter @tirodhan/customer-web run dev",
    "dev:customer-web:fixture": "pnpm --filter @tirodhan/customer-web run dev:fixture",
    "typecheck:customer-web": "turbo run typecheck --filter=@tirodhan/customer-web",
    "lint:customer-web": "turbo run lint --filter=@tirodhan/customer-web",
    "test:customer-web": "turbo run test --filter=@tirodhan/customer-web",
    "build:customer-web": "turbo run build --filter=@tirodhan/customer-web",
    "dev:operations": "pnpm --filter @tirodhan/operations-web run dev",
    "dev:operations:fixture": "pnpm --filter @tirodhan/operations-web run dev:fixture",
    "typecheck:operations": "turbo run typecheck --filter=@tirodhan/operations-web",
    "lint:operations": "turbo run lint --filter=@tirodhan/operations-web",
    "test:operations": "turbo run test --filter=@tirodhan/operations-web",
    "build:operations": "turbo run build --filter=@tirodhan/operations-web",
    "dev:rider": "pnpm --filter @tirodhan/rider-mobile start",
    "dev:rider:go": "pnpm --filter @tirodhan/rider-mobile start:go",
    "typecheck:rider": "turbo run typecheck --filter=@tirodhan/rider-mobile",
    "lint:rider": "turbo run lint --filter=@tirodhan/rider-mobile",
    "test:rider": "turbo run test --filter=@tirodhan/rider-mobile",
    "doctor:rider": "pnpm --filter @tirodhan/rider-mobile run doctor",
    "dev:customer": "pnpm --filter @tirodhan/customer-mobile start",
    "dev:customer:go": "pnpm --filter @tirodhan/customer-mobile start:go",
    "typecheck": "turbo run typecheck --filter=@tirodhan/customer-mobile",
    "lint": "turbo run lint --filter=@tirodhan/customer-mobile",
    "test": "turbo run test --filter=@tirodhan/customer-mobile",
    "doctor": "pnpm --filter @tirodhan/customer-mobile run doctor",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8"
  }
}
