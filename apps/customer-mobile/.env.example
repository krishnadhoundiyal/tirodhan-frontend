EXPO_PUBLIC_API_BASE_URL=https://your-apim-host.example
# No credentials belong in EXPO_PUBLIC_* variables.
# Optional public, package-restricted Maps SDK key for Android map tiles.
GOOGLE_MAPS_ANDROID_API_KEY=
# Local native Firebase configuration file; never commit it.
GOOGLE_SERVICES_FILE=
# One authoritative mode. SCREEN_PREVIEW requires __DEV__ and Expo Go.
# NONPROD uses real authentication and HTTPS backend services. Unset uses production behavior.
EXPO_PUBLIC_APP_MODE=NONPROD
# Deprecated and ignored: EXPO_PUBLIC_PREVIEW_CATALOGUE. Remove it from local .env.
# Enable only PROPOSED capabilities actually implemented and verified on this backend.
# See docs/CUSTOMER_MOBILE_BACKEND_CONTRACTS.md; this is not authorization.
EXPO_PUBLIC_CUSTOMER_CAPABILITIES=
# Optional approved browser-preview tile provider, using {z}/{x}/{y}. Native maps are separate.
EXPO_PUBLIC_WEB_MAP_TILE_URL=
