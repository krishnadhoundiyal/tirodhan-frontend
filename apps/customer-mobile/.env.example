EXPO_PUBLIC_API_BASE_URL=https://your-apim-host.example
# No credentials belong in EXPO_PUBLIC_* variables.
# Optional public, package-restricted Maps SDK key for Android map tiles.
GOOGLE_MAPS_ANDROID_API_KEY=
# Local native Firebase configuration file; never commit it.
GOOGLE_SERVICES_FILE=
# Development visual catalogue only; never enable in a production build.
EXPO_PUBLIC_PREVIEW_CATALOGUE=false
